+std::vector<float> TransformerAttentionDesc::computeGraphBias(int tensorLen) const {
+  const auto& geometry = BentYGraph::geometry(tensorLen);
+  const size_t pairs = geometry.points.size()*geometry.points.size();
+  const int hidden = graphBiasInput.outChannels;
+  std::vector<float> result(numHeads*pairs,0.0f);
+  std::vector<float> encoded(hidden);
+  for(size_t pair = 0; pair < pairs; pair++) {
+    for(int channel = 0; channel < hidden; channel++) {
+      float value = 0.0f;
+      for(int feature = 0; feature < 10; feature++)
+        value += geometry.features[pair*10+feature] * graphBiasInput.weights[feature*hidden+channel];
+      encoded[channel] = value/(1.0f+std::exp(-value));
+    }
+    for(int head = 0; head < numHeads; head++) {
+      float value = 0.0f;
+      for(int channel = 0; channel < hidden; channel++)
+        value += encoded[channel] * graphBiasOutput.weights[channel*numHeads+head];
+      result[head*pairs+pair] = value;
+    }
+  }
+  return result;
 }
 
