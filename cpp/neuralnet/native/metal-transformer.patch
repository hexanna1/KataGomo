+// Triangle tokens retain their square-board indices for RoPE.
+struct YTriangleSequence {
+    let width: Int
+    let points: [Int]
+
+    init(width: Int) {
+        self.width = width
+        points = (0..<width).flatMap { y in (0..<(width - y)).map { x in y * width + x } }
+    }
+
+    func indices(_ graph: MPSGraph, _ values: [Int]) -> MPSGraphTensor {
+        let codes = values.map { Int32($0) }
+        let data = codes.withUnsafeBufferPointer { Data(buffer: $0) }
+        return graph.constant(data, shape: [codes.count as NSNumber], dataType: .int32)
+    }
+
+    func gather(_ graph: MPSGraph, _ source: MPSGraphTensor) -> MPSGraphTensor {
+        let channels = source.shape![1]
+        let flat = graph.reshape(source, shape: [-1, channels, (width * width) as NSNumber], name: nil)
+        let packed = graph.gather(withUpdatesTensor: flat, indicesTensor: indices(graph, points), axis: 2, batchDimensions: 0, name: nil)
+        return graph.reshape(packed, shape: [-1, channels, 1, points.count as NSNumber], name: nil)
+    }
+
+    func restore(_ graph: MPSGraph, _ source: MPSGraphTensor) -> MPSGraphTensor {
+        let channels = source.shape![1]
+        let flat = graph.reshape(source, shape: [-1, channels, points.count as NSNumber], name: nil)
+        let first = graph.sliceTensor(flat, dimension: 2, start: 0, length: 1, name: nil)
+        let zero = graph.multiplication(first, graph.constant(0.0, dataType: .float32), name: nil)
+        let padded = graph.concatTensors([flat, zero], dimension: 2, name: nil)
+        var reverse = [Int](repeating: points.count, count: width * width)
+        for (index, point) in points.enumerated() { reverse[point] = index }
+        let restored = graph.gather(withUpdatesTensor: padded, indicesTensor: indices(graph, reverse), axis: 2, batchDimensions: 0, name: nil)
+        return graph.reshape(restored, shape: [-1, channels, width as NSNumber, width as NSNumber], name: nil)
+    }
+}
